# syntax=docker/dockerfile:1
#
# Runtime image for the relay acceptance test in compose.relay.yaml.
# It holds the relay server, the tiny test peer, and the swarm binary with its
# git remote helper, so the same image plays relay and peer.

FROM rust:1-slim-bookworm AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config cmake clang libclang-dev llvm lld \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN cargo build --locked -p swarm-relay -p swarm-cli

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates netcat-openbsd iproute2 procps busybox jq \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/debug/swarm-relay /usr/local/bin/swarm-relay
COPY --from=build /src/target/debug/swarm-relay-peer /usr/local/bin/swarm-relay-peer
COPY --from=build /src/target/debug/swarm /usr/local/bin/swarm
RUN ln -s /usr/local/bin/swarm /usr/local/bin/git-remote-swarm \
 && git config --system user.name "swarm peer" \
 && git config --system user.email "peer@swarm.invalid" \
 && git config --system init.defaultBranch main

RUN mkdir -p /state/home /state/work
ENV SWARM_HOME=/state/home \
    SWARM_NO_DHT=1 \
    SWARM_NO_LAN=1 \
    SWARM_NO_UPNP=1
WORKDIR /state/work

CMD ["sleep", "infinity"]

.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH swarm-fork 1  "swarm 0.2.0" "Swarmgit manual"
.SH NAME
swarm\-fork \- Create an independent repo from another one
.SH SYNOPSIS
\fBswarm fork\fR [\fB\-\-json\fR] [\fB\-h\fR|\fB\-\-help\fR] <\fILINK\fR> 
.SH DESCRIPTION
Create an independent repo from another one
.SH OPTIONS
.TP
\fB\-\-json\fR
Print one JSON object on stdout
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fILINK\fR>
The source link, optionally with hints

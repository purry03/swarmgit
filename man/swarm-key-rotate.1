.el .ds Aq '
.TH swarm-key-rotate 1  "swarm 0.2.2" "Swarmgit manual"
.SH NAME
swarm\-key\-rotate \- Move the root to a new key, authorized by the recovery key file
.SH SYNOPSIS
\fBswarm key rotate\fR <\fB\-\-recovery\fR> [\fB\-h\fR|\fB\-\-help\fR] <\fIREPO\fR> 
.SH DESCRIPTION
Move the root to a new key, authorized by the recovery key file
.SH OPTIONS
.TP
\fB\-\-recovery\fR \fI<FILE>\fR

.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fIREPO\fR>


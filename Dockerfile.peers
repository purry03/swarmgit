# syntax=docker/dockerfile:1
#
# Runtime image for the two-peer demo in compose.peers.yaml.
#
# It builds the `swarm` binary together with its `git-remote-swarm` alias, so a
# peer container only needs git and a shell to act as a Swarmgit node.

FROM rust:1-slim-bookworm AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config cmake clang libclang-dev llvm lld \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN cargo build --locked -p swarm-cli

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates sqlite3 jq procps iproute2 tar \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/debug/swarm /usr/local/bin/swarm
RUN ln -s /usr/local/bin/swarm /usr/local/bin/git-remote-swarm \
 && git config --system user.name "swarm peer" \
 && git config --system user.email "peer@swarm.invalid" \
 && git config --system init.defaultBranch main

# A place for the daemon state and for the user's worktrees.
RUN mkdir -p /state/home /state/work
ENV SWARM_HOME=/state/home \
    SWARM_NO_DHT=1 \
    SWARM_NO_LAN=1
WORKDIR /state/work

CMD ["sleep", "infinity"]

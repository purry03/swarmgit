(( $+functions[_swarm_commands] )) ||
_swarm_commands() {
    local commands; commands=(
'init:Create a repo key and publish the first manifest' \
'link:Print the link for a repo' \
'status:Show the daemon, repos, relays and peers' \
'inspect:Inspect signed repository metadata without downloading Git objects' \
'about:Show or set a repo'\''s name and description (root or maintainer key)' \
'discover-relays:Find public relay servers through the Mainline DHT and relay gossip' \
'seed:Sync a repo and keep serving it' \
'unseed:Stop serving a repo but keep its store' \
'gc:Repack a repo'\''s store and drop unreachable objects, when idle (ST-7)' \
'purge:Delete a repo'\''s store and manifests, and stop serving it' \
'fork:Create an independent repo from another one' \
'export:Write a repo and its signed state to a bundle file for offline transfer' \
'mirror:Publish a repo for static mirrors (plain file hosting)' \
'import:Read a bundle file, making its repo available offline' \
'maintainers:Add or remove maintainers, who may publish without the root key' \
'accept:Settle a ref conflict here by taking one signer'\''s value' \
'key:Key management' \
'completions:Print a shell completion script (bash, zsh, fish, elvish, powershell)' \
'relay:Run a relay server for peers that cannot accept connections' \
'daemon:Start, stop or restart the background daemon' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'swarm commands' commands "$@"
}
(( $+functions[_swarm__subcmd__about_commands] )) ||
_swarm__subcmd__about_commands() {
    local commands; commands=()
    _describe -t commands 'swarm about commands' commands "$@"
}
(( $+functions[_swarm__subcmd__accept_commands] )) ||
_swarm__subcmd__accept_commands() {

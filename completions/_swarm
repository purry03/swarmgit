}
(( $+functions[_swarm__subcmd__daemon_commands] )) ||
_swarm__subcmd__daemon_commands() {
    local commands; commands=(
'start:Start the daemon in the background' \
'stop:Stop the running daemon' \
'restart:Stop the daemon if it is running, then start it' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'swarm daemon commands' commands "$@"
}

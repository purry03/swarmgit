# syntax=docker/dockerfile:1
#
# Swarmgit development and e2e test image.
#
# Build from the repository root:
#   docker compose build
#   HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose build   # if not 1000:1000
#
FROM rust:1-slim-bookworm

ARG USER_ID=1000
ARG GROUP_ID=1000

ENV DEBIAN_FRONTEND=noninteractive

# Build toolchain plus everything the acceptance and e2e suites shell out to.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config cmake clang libclang-dev llvm lld \
      git jq \
      python3 python3-pip python3-venv \
      curl ca-certificates \
      iproute2 util-linux procps \
      tcpdump netcat-openbsd socat \
      sqlite3 iptables nftables \
 && rm -rf /var/lib/apt/lists/*

# Stable components, nightly for cargo-fuzz, and the tools the spec's CI uses.
RUN rustup component add rustfmt clippy \
 && rustup toolchain install nightly --profile minimal \
 && cargo install --locked cargo-fuzz cargo-deny

# rust-toolchain.toml selects the `stable` channel. Bake it into the image so a
# fresh container does not download it (and print an auto-install warning) on
# first use.
RUN rustup toolchain install stable --profile minimal \
 && rustup component add --toolchain stable rustfmt clippy

# Isolated Python for scripts/gen_vectors.py.
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir blake3
ENV PATH="/opt/venv/bin:${PATH}"

# Unprivileged user matching the host UID/GID so bind-mounted files stay owned
# by the host user rather than root.
RUN groupadd --gid "${GROUP_ID}" dev \
 && useradd --uid "${USER_ID}" --gid dev --create-home --shell /bin/bash dev \
 && mkdir -p /home/dev/.cargo \
 && touch /home/dev/.cargo/.keep \
 && chown -R dev:dev /home/dev \
 && chown -R dev:dev /usr/local/cargo /usr/local/rustup

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_TERM_COLOR=always \
    RUST_BACKTRACE=1

USER dev
WORKDIR /workspace

CMD ["/bin/bash"]
